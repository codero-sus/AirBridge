<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Needed for peer-to-peer HTTP/WS on private LANs. Use TLS for non-LAN traffic. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
